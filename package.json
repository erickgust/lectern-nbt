{
  "name": "lectern-nbt",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "suppressions": "! grep -rnE 'oxlint-disable|eslint-disable|@ts-ignore|@ts-nocheck|@ts-expect-error' src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/speed.bench.ts",
    "bench:memory": "node --expose-gc bench/memory.mjs",
    "package:check": "bun run build && publint && attw --pack . --profile esm-only",
    "check": "bun run format:check && bun run lint && bun run suppressions && bun run typecheck && bun run test && bun run package:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fast-check/vitest": "0.5.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "mitata": "1.0.34",
    "mutf-8": "1.2.5",
    "nbtify": "2.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "prismarine-nbt": "2.8.0",
    "publint": "0.3.25",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
